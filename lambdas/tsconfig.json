{
   "compilerOptions": {
      "lib": [
         "es5",
         "es6"
      ],
      "target": "es5",
      "module": "commonjs",
      "moduleResolution": "node",
      "outDir": "./dist",
      "emitDecoratorMetadata": true,
      "experimentalDecorators": true,
      "sourceMap": true,
      "typeRoots" : ["./node_modules/@types", "./typings"],
      "esModuleInterop": true,
      "rootDir": "./src",
      "types": ["node", "jest"],
   },
   "exclude": ["test"]
}
