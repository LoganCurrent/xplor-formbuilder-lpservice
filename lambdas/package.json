{
  "name": "landing-page-service",
  "version": "0.1.1",
  "description": "This service manages campaigns, campaign items, enrollment, and re-enrollment functionality.",
  "main": "src/index.js",
  "scripts": {
    "test": "ENV=test jest",
    "test:integration": "ENV=test jest -c jest.config.integration.js --runInBand --forceExit",
    "local": "NODE_OPTIONS=\"--max-http-header-size=16384\" ENV=dev npx tsc && npx sls offline --stage local --disableCookieValidation",
    "build-tsc": "tsc",
    "build": "tsc && cp src/utils/template.html dist/utils/template.html",
    "deploy-staging": "ENV=staging npm run build && npx serverless deploy --stage staging",
    "deploy-prod": "npm run build && npx serverless deploy --stage prod",
    "lint:fix": "eslint --fix src __tests__",
    "lint:check": "eslint src __tests__",
    "typeorm": "node --require ts-node/register ./node_modules/typeorm/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrandyBots/microservice.git"
  },
  "author": "BrandBot",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/BrandyBots/microservice/issues"
  },
  "homepage": "https://github.com/BrandyBots/microservice#readme",
  "dependencies": {
    "@aws-sdk/client-sqs": "3.34.0",
    "@sentry/node": "^5.19.1",
    "@types/redis": "^2.8.27",
    "aws-lambda": "1.0.6",
    "aws-serverless-express": "3.3.8",
    "axios": "^0.21.0",
    "compression": "1.7.4",
    "configcat-node": "^11.3.1",
    "connect-datadog": "0.0.9",
    "cors": "2.8.5",
    "express": "4.17.1",
    "express-interceptor": "^1.2.0",
    "express-validator": "6.6.1",
    "express-winston": "^4.0.5",
    "helmet": "4.1.1",
    "lodash": "^4.17.21",
    "moment-timezone": "^0.5.31",
    "mysql2": "2.1.0",
    "redis": "^3.0.2",
    "reflect-metadata": "0.1.13",
    "serverless-dotenv-plugin": "^3.12.2",
    "typeorm": "0.2.25",
    "uuid": "^8.3.1",
    "winston": "^3.3.3"
  },
  "devDependencies": {
    "@sentry/cli": "^1.55.1",
    "@types/aws-lambda": "^8.10.61",
    "@types/aws-serverless-express": "^3.3.3",
    "@types/express": "^4.17.8",
    "@types/faker": "^5.1.0",
    "@types/jest": "^26.0.14",
    "@types/node": "^14.0.27",
    "@typescript-eslint/eslint-plugin": "^3.9.0",
    "@typescript-eslint/parser": "^3.9.0",
    "dotenv": "^16.5.0",
    "eslint": "^7.6.0",
    "eslint-config-prettier": "^6.9.0",
    "eslint-plugin-jest": "^23.18.0",
    "eslint-plugin-prettier": "^3.1.4",
    "jest": "^26.5.2",
    "js-yaml": "^3.14.0",
    "mock-aws-s3": "^4.0.1",
    "prettier": "2.0.5",
    "redis-mock": "^0.52.0",
    "serverless": "3.38",
    "serverless-domain-manager": "^5.1.0",
    "serverless-offline": "^10.3.2",
    "serverless-plugin-datadog": "^2.6.1",
    "ts-jest": "^26.4.1",
    "ts-node": "8.10.2",
    "typeorm-seeding": "^1.6.1",
    "typescript": "^4.9.5",
    "serverless-offline-sqs": "^7.3.2"
  }
}
